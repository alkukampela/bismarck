{
  "name": "bismarck",
  "version": "1.0.0",
  "description": "Bismarck game",
  "repository": {
    "type": "git",
    "url": "git+htttp://github.com/alkukampela/bismarck.git"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">=9"
  },
  "author": "RK",
  "license": "MIT",
  "workspaces": [
    "src/bismarck-web",
    "src/bismarck-server"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "src/bismarck-server/**/*.{ts,js}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "src/bismarck-web/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "src/bismarck-server/**/*.{json,md}": [
      "prettier --write"
    ],
    "src/bismarck-web/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
