{
  "scripts": {
    "develop": "concurrently -r \"npm:type-check:watch\" \"npm:start\"",
    "start": "parcel ./src/index.html",
    "build": "npm run type-check && parcel build ./src/index.html --public-url '/'",
    "prettier": "prettier --write './src/**/*.{ts,tsx}'",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 7.0.0"
  },
  "browserslist": [
    "> 1%",
    "not IE 11"
  ],
  "jest": {
    "preset": "ts-jest",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "moduleNameMapper": {
      ".+\\.css$": "<rootDir>/src/styleMock.ts"
    },
    "testMatch": [
      "**/__tests__/*.(test|spec).(ts|tsx|js)"
    ]
  },
  "keywords": [
    "Typescript",
    "React",
    "Parcel"
  ],
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "@parcel/transformer-mdx": "^2.13.3",
    "@parcel/transformer-typescript-tsc": "^2.0.1",
    "@testing-library/jest-dom": "^5.16.1",
    "@types/jest": "^26.0.24",
    "@types/mdx": "^2.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "concurrently": "^6.5.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^7.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^26.6.3",
    "jest-extended": "^0.11.1",
    "parcel": "^2.0.1",
    "prettier": "^2.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pin-field": "^3.1.5",
    "react-router-dom": "^6.2.1",
    "react-test-renderer": "^18.2.0",
    "reconnecting-websocket": "^4.4.0",
    "ts-jest": "^26.5.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
