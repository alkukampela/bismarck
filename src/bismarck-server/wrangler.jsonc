{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bismarck-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-24",
	"migrations": [
		{
			"new_sqlite_classes": [
				"GameStorage"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "GameStorage",
				"name": "GAME_STORAGE"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "LOGIN_TOKENS",
			"id": "e6b0e91381e34ecba69b8424b6feeaf1",
			"preview_id": "e6b0e91381e34ecba69b8424b6feeaf1"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"DISABLE_EMAIL_SENDING": "false",
		"SMTP_HOST": "email-smtp.eu-west-1.amazonaws.com",
    "SES_URL": "https://email.eu-west-1.amazonaws.com/v2/email/outbound-emails",
    "SES_REGION": "eu-west-1",
		"SMTP_USERNAME": "AKIA2W5WH2HO3PW4ANPY",
    "CORS_ORIGIN": "https://bismarck.monster"
	}
}
